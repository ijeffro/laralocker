{
    "name": "ijeffro/laralocker",
    "description": "A Laravel API connector for Learning Locker®, the open-source Learning Record Store.",
    "keywords": [
        "laravel",
        "learning locker",
        "xapi",
        "lrs"
    ],
    "license": "MIT",
    "homepage": "https://ijeffro.github.io/laralocker/",
    "support": {
        "issues": "https://github.com/ijeffro/laralocker/issues",
        "source": "https://github.com/ijeffro/laralocker"
    },
    "authors": [
        {
            "name": "Phil Graham",
            "homepage": "https://github.com/ijeffro"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ijeffro\\Laralocker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ijeffro\\Laralocker\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Ijeffro\\Laralocker\\LaralockerServiceProvider"
            ],
            "aliases": {
                "LearningLocker": "Ijeffro\\Laralocker\\Facades\\LearningLocker",
                "xAPI": "Ijeffro\\Laralocker\\Facades\\XAPI"
            }
        }
    }
}
